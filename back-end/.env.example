# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Derived from the above — used by the API container
DATABASE_URL=postgresql://app_user:changeme@localhost:5432/app_db

# Reverse proxies in front of the API (0 locally; production value is measured, see README)
TRUST_PROXY_HOPS=0

# Frontend origin allowed by CORS (no trailing slash)
CORS_ORIGIN=http://localhost:3001

# Clerk — `npx clerk@latest env pull --file .env` writes the two keys for the linked app.
# Session tokens are accepted only when minted for CORS_ORIGIN (their `azp` claim).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Signing secret of the Clerk webhook endpoint (<api>/webhooks/clerk); `clerk webhooks listen` prints one locally
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Optional: PEM public key for networkless token verification (Dashboard → API keys → JWT public key)
# CLERK_JWT_KEY=

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
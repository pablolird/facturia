VITE_API_BASE_URL=http://localhost:3000

# Cloudflare Turnstile site key (public, safe to expose in the client bundle).
# The value below is Cloudflare's documented "always passes" test key for local dev —
# replace with a real site key from https://dash.cloudflare.com/?to=/:account/turnstile for prod.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
